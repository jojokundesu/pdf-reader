{
  "name": "flipvault-pro",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "android:sync": "npm run build && cap sync android",
    "format": "prettier --write src tests vite.config.js",
    "test:large": "node tests/large-pdf.mjs",
    "test:update": "node tests/reader-update.mjs",
    "test:audio": "node tests/page-audio.mjs",
    "dictionary": "node scripts/build-dictionary.mjs",
    "predev": "npm run dictionary",
    "prebuild": "npm run dictionary",
    "pretest:e2e": "npm run dictionary"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@pdf-lib/fontkit": "^1.1.1",
    "djvu-rs": "^0.43.0",
    "jszip": "^3.10.2",
    "lucide": "^0.468.0",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.51.0",
    "@sparticuz/chromium": "^153.0.0",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "vite": "^6.1.0",
    "wait-on": "^9.5.1",
    "wordnet": "^2.0.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.1"
  }
}
